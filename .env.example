# ============================================================
# Admin Dashboard — Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# In production (Vercel, Netlify, etc.), set these as platform
# environment variables — do NOT commit .env.local to git.
# ============================================================

# ─── Backend API URL ─────────────────────────────────────────
# REQUIRED: The full URL of the backend API (including /api)
# Local development:
VITE_API_BASE_URL=http://localhost:5000/api
# Production (uncomment and set your actual backend domain):
# VITE_API_BASE_URL=https://api.yourschool.com/api
